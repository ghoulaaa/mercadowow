# Configuración de Mercado WoW Forever.
# Copia este archivo como .env (instalar.bat lo hace por ti) y rellena lo que falta.
# Las líneas que empiezan con # son comentarios. Guía paso a paso: docs/SUPABASE.md
#
# ¡Este archivo .env contiene tu contraseña! No lo compartas ni lo subas a internet.

# --- Supabase (obligatorio) ---
# Panel de Supabase → botón "Connect" → pestaña "Connection String" → "Session pooler".
# Cambia [YOUR-PASSWORD] por la contraseña de la base de datos.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Panel de Supabase → Project Settings → Data API → "Project URL".
SUPABASE_URL=https://xxxxxxxx.supabase.co

# --- Página web local ---
# 127.0.0.1 = solo este PC (recomendado). No uses 0.0.0.0 hasta que haya contraseña.
HOST=127.0.0.1
PUERTO=8000

# Mercado a analizar. Por ahora solo existe este.
MERCADO=tsm:forever:us:pvp-horde

# Carpeta del registro de actividad de la página local.
RUTA_LOGS=logs
